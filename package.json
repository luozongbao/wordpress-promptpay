{
  "name": "woocommerce-promptpay-gateway",
  "version": "1.0.0",
  "description": "WooCommerce payment gateway for PromptPay (Thailand)",
  "main": "woocommerce-promptpay-gateway.php",
  "scripts": {
    "build": "webpack --mode=production",
    "dev": "webpack --mode=development --watch",
    "lint:php": "phpcs --standard=WordPress .",
    "lint:php:fix": "phpcbf --standard=WordPress .",
    "lint:js": "eslint assets/js/",
    "lint:js:fix": "eslint assets/js/ --fix",
    "test": "phpunit",
    "zip": "zip -r woocommerce-promptpay-gateway.zip . -x '*.git*' 'node_modules/*' 'tests/*' '*.log' 'composer.lock' 'vendor/*'"
  },
  "keywords": [
    "wordpress",
    "woocommerce",
    "promptpay",
    "payment-gateway",
    "thailand",
    "qr-code"
  ],
  "author": "Zongbao Luo",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/luozongbao/wordpress-promptpay.git"
  },
  "bugs": {
    "url": "https://github.com/luozongbao/wordpress-promptpay/issues"
  },
  "homepage": "https://github.com/luozongbao/wordpress-promptpay#readme",
  "devDependencies": {
    "@wordpress/eslint-plugin": "^17.0.0",
    "eslint": "^8.50.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
