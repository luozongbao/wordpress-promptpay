<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for PromptPay Gateway">
    <description>WordPress coding standards for WooCommerce PromptPay Gateway plugin</description>

    <!-- Show sniff codes in all reports -->
    <arg value="s"/>
    
    <!-- Show progress and sniff codes -->
    <arg name="colors"/>
    <arg value="p"/>

    <!-- Paths to check -->
    <file>.</file>

    <!-- Exclude paths -->
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>

    <!-- Include WordPress Coding Standards -->
    <rule ref="WordPress">
        <!-- Exclude rules that conflict with modern PHP -->
        <exclude name="WordPress.Arrays.MultipleStatementAlignment.DoubleArrowNotAligned"/>
        <exclude name="WordPress.PHP.DisallowShortTernary.Found"/>
        
        <!-- Allow camelCase for JavaScript-style object properties -->
        <exclude name="WordPress.NamingConventions.ValidVariableName.PropertyNotSnakeCase"/>
        
        <!-- Allow short array syntax -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax.Found"/>
    </rule>

    <!-- WordPress Extra rules -->
    <rule ref="WordPress-Extra">
        <!-- Exclude file header rules for simplicity -->
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
    </rule>

    <!-- WordPress Docs rules -->
    <rule ref="WordPress-Docs"/>

    <!-- Check for minimum PHP version -->
    <config name="minimum_supported_wp_version" value="5.0"/>
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- WordPress VIP rules (for security) -->
    <rule ref="WordPress-VIP-Go">
        <!-- Allow file operations for QR code generation -->
        <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
        <exclude name="WordPress.WP.AlternativeFunctions.file_system_read_file_get_contents"/>
    </rule>

    <!-- Security rules -->
    <rule ref="WordPress.Security"/>

    <!-- Performance rules -->
    <rule ref="WordPress.Performance"/>

    <!-- Custom rules for the plugin -->
    <rule ref="Generic.Commenting.DocComment"/>
    <rule ref="Generic.Functions.FunctionCallArgumentSpacing"/>
    <rule ref="Generic.NamingConventions.UpperCaseConstantName"/>
    <rule ref="Generic.PHP.LowerCaseConstant"/>
    <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
    
    <!-- Array and object rules -->
    <rule ref="WordPress.Arrays.ArrayIndentation"/>
    <rule ref="WordPress.Arrays.ArrayKeySpacingRestrictions"/>
    <rule ref="WordPress.Arrays.CommaAfterArrayItem"/>

    <!-- Variable rules -->
    <rule ref="WordPress.NamingConventions.ValidVariableName"/>
    <rule ref="WordPress.NamingConventions.ValidFunctionName"/>
    <rule ref="WordPress.NamingConventions.ValidHookName"/>

    <!-- Text domain verification -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wc-promptpay-gateway"/>
            </property>
        </properties>
    </rule>
</ruleset>
